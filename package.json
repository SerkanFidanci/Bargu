{
  "name": "bargu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.12.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @bargu/api dev",
    "dev:mobile": "pnpm --filter \"@bargu/mobile^...\" run build && pnpm --filter @bargu/mobile dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "prepare": "husky",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@bargu/config": "workspace:*",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
