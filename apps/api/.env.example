# Local development only. Copy to .env (never committed). Values match infra/.env.example.
NODE_ENV=development
APP_ENV=development
# 0.0.0.0 lets a phone on the same Wi-Fi reach the API; use 127.0.0.1 if you only need localhost.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Runtime role created by `pnpm --filter @bargu/api db:migrate` (no RLS bypass, owns nothing).
DATABASE_URL=postgres://bargu_app:change-me-local-app-role@127.0.0.1:5432/bargu
REDIS_URL=redis://default:change-me-local-only@127.0.0.1:6379
# Comma separated IPs/CIDRs of reverse proxies to trust (empty locally).
TRUST_PROXY=

# Migration step only (superuser from infra/.env); the API never reads these.
DATABASE_ADMIN_URL=postgres://bargu:change-me-local-only@127.0.0.1:5432/bargu
DB_APP_PASSWORD=change-me-local-app-role

# 32-byte keys, unpadded base64url. Generate fresh ones for your .env:
#   node -e "for (const k of ['JWT_SIGNING_KEY','OTP_KEY','EMAIL_LOOKUP_KEY','JOB_PAYLOAD_KEY']) console.log(k + '=' + require('crypto').randomBytes(32).toString('base64url'))"
JWT_SIGNING_KEY=
OTP_KEY=
EMAIL_LOOKUP_KEY=
JOB_PAYLOAD_KEY=

# Mailpit from infra/docker-compose.yml (ports MAILPIT_SMTP_PORT / MAILPIT_UI_PORT in infra/.env);
# read the codes in its web UI, by default http://127.0.0.1:8025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Bargu <no-reply@bargu.localhost>

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081
# Where the account web page (/hesap) is, for links in emails; without it, the first web origin
# above (on staging the API's own host).
# WEB_ORIGIN=http://localhost:3000
# The host invite links open on (https://<host>/i/<token>): the invite page, its card image and the
# Android App Links check (/.well-known/assetlinks.json, ANDROID_CERT_SHA256). A bare host name; the
# default is the staging API's host, and production must set its own (docs/ADR/0009 Ek).
# INVITE_HOST=invite.example.com
DEVICE_ATTESTATION=optional
