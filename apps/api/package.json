{
  "name": "@bargu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate-cli.js",
    "notice-key:dev": "node dist/push/dev-notice-key-cli.js",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@bargu/crypto": "workspace:*",
    "@bargu/schemas": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "@peculiar/x509": "2.1.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@bargu/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fastify": "5.12.5",
    "light-my-request": "6.6.0",
    "socket.io-client": "4.8.4",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
