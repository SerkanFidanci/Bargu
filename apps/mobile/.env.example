# Optional in development: without it, the app calls the API on the machine running Metro
# (http://<your-LAN-IP>:3000). Release builds require an https URL (set it per EAS environment).
# EXPO_PUBLIC_API_URL=https://api.example.com
# The server notice key a development bundle trusts (QA-28 B-1): the public line
# `pnpm --filter @bargu/api notice-key:dev` prints for the local API, the same as eas.json's
# development profile. Without it, the app drops every notice of the local API.
# EXPO_PUBLIC_NOTICE_KEYS=dev-n1:<public key>
