{
  "name": "@bargu/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "eas-build-post-install": "pnpm --filter \"@bargu/mobile^...\" run build"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "testMatch": [
      "**/src/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble|@scure|@gorhom|@maplibre|lucide-react-native|react-native-svg|@testing-library))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "resolver": "react-native-worklets/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@bargu/crypto": "workspace:*",
    "@bargu/schemas": "workspace:*",
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.104.2",
    "@types/geojson": "7946.0.16",
    "expo": "~57.0.27",
    "expo-battery": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "i18next": "26.4.4",
    "lucide-react-native": "1.55.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-passkey": "3.6.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "4.8.4",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@bargu/config": "workspace:*",
    "@protomaps/basemaps": "5.7.2",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
