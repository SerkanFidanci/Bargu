# 1) Secrets never reach a commit. 2) Staged files are linted and formatted.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (secret scanning)." >&2
  echo "  Windows: winget install --id Gitleaks.Gitleaks   macOS/Linux: brew install gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --verbose

pnpm exec lint-staged
