# Local development only. Copy to infra/.env (never committed).
# These containers listen on 127.0.0.1 only; staging/production secrets live on the server.
POSTGRES_USER=bargu
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bargu
REDIS_PASSWORD=change-me-local-only

# Host ports (change if another local project already uses them).
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
