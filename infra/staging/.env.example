# Staging secrets: create /opt/bargu/staging/.env on the server (mode 600, owner deploy).
# Never commit the real file. Generate each secret with: openssl rand -hex 32
# (hex keeps them URL-safe inside DATABASE_URL / REDIS_URL).
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=bargu
POSTGRES_DB=bargu
POSTGRES_PASSWORD=
REDIS_PASSWORD=
