# Staging secrets: /opt/bargu/staging/.env on the server (mode 600, owner deploy). Never commit it.
# setup-staging.sh generates the passwords on the server (openssl rand -hex 32; hex keeps them
# URL-safe inside DATABASE_URL / REDIS_URL).
POSTGRES_USER=bargu
POSTGRES_DB=bargu
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Loopback port the host nginx proxies to.
API_HOST_PORT=3100

# Faz 2. setup-staging.sh appends generated values when missing; never commit real ones.
# Runtime database role bargu_app (hex keeps it URL-safe inside DATABASE_URL).
DB_APP_PASSWORD=
# 32-byte keys, unpadded base64url.
JWT_SIGNING_KEY=
OTP_KEY=
EMAIL_LOOKUP_KEY=
JOB_PAYLOAD_KEY=
# Passkey relying party: the API domain until the real domain exists (BARGU_API_DOMAIN).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# Optional: Android signing certificate fingerprints for assetlinks.json, comma separated. Public
# values (every APK carries its certificate). Passkeys and the https invite links (Android App
# Links, docs/ADR/0009 Ek) work only for an app whose certificate is listed here. The preview and
# local test builds (EAS and scripts/build-android-local.sh sign alike) are:
#   BC:B3:1B:94:9A:2D:4F:86:2E:BD:41:5C:6E:C4:28:C5:16:3D:A7:76:F1:4B:49:E1:40:A3:CE:AD:57:FB:84:42
# (apksigner verify --print-certs on the APK). Google Play's signing certificate is added when the
# app is on Play.
ANDROID_CERT_SHA256=
# Optional: the host invite links open on (https://<host>/i/<token>); default is this API's own
# staging host. The apps are built for one host as well (EXPO_PUBLIC_INVITE_HOST in eas.json).
# INVITE_HOST=
# Optional: a real SMTP relay instead of the internal Mailpit (docs/ADR/0006). For a Gmail account
# do not edit these by hand: run `bargu-set-mail` on the server (infra/staging/set-mail.sh).
# SMTP_URL=smtp://user:pass@smtp.example:587
# MAIL_FROM=Bargu <giris@example.com>
# Optional: the server's notice signing key (QA-28 B-1, docs/ADR/0016 Ek). Do not write it by hand:
# infra/staging/notice-key.sh makes it on the server and writes only its public half out.
# NOTICE_SIGNING_KEY=
# NOTICE_SIGNING_KID=stg-n1
